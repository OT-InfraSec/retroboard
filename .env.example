# Shared password for HTTP Basic Auth (any username)
BASIC_AUTH_PASSWORD=change-me
# Fine-grained PAT with "Issues: read and write" on the target repository
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=acme/planning
# Used for deep links in GitHub issues
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://retroboard:retroboard@localhost:5432/retroboard
